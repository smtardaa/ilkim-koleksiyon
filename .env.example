# Yayın adresi ve alt yolu. Boş bırakılırsa GitHub Pages değerleri kullanılır:
# SITE_URL=https://smtardaa.github.io, BASE_PATH=/ilkim-koleksiyon
# Özel alan adına geçilirse örn. SITE_URL=https://www.ornek.com ve BASE_PATH=/
SITE_URL=
BASE_PATH=

# Arama motoru indekslemesi. Demo için false kalmalı; yalnızca üretimde true yapın.
PUBLIC_ALLOW_INDEXING=false

# Ürün veri kaynağı: "mock" (örnek veri) veya ileride "shopify".
DATA_SOURCE=mock

# --- Shopify (henüz kullanılmıyor, entegrasyon aşamasında doldurulacak) ---
# Storefront API public token tarayıcıda kullanılabilir; Admin API anahtarları
# ve webhook sırrı ASLA PUBLIC_ önekiyle tanımlanmaz, istemci koduna girmez.
# PUBLIC_SHOPIFY_STORE_DOMAIN=
# PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_PRIVATE_STOREFRONT_TOKEN=
# SHOPIFY_WEBHOOK_SECRET=
