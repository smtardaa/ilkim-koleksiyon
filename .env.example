# =====================================================================
# İlkim Koleksiyon — ortam değişkenleri (ÖRNEK)
# Bu dosyayı `.env` adıyla kopyalayın. `.env` sürüm kontrolüne EKLENMEZ.
# Gerçek sırlar yalnızca sunucu ortamında (hosting paneli / gizli değişken) tutulur.
# =====================================================================

# Sitenin tam adresi (canonical, Open Graph, sitemap için). Sonunda / olmadan.
# Yerel: http://localhost:5500   Canlı: https://www.ornek-alan-adi.com.tr
SITE_URL=http://localhost:5500

# Veri kaynağı: demo (yerel örnek envanter) | shopify (Storefront API)
STORE_MODE=demo

# Arama motoru indekslemesi: off | on
# “on” olsa bile yalnızca STORE_MODE=shopify ve SITE_URL gerçek bir https alan adı ise açılır.
SITE_INDEXING=off

# Satılmış ürünlerin görünürlüğü: visible | unlisted | hidden
#  visible  → listelerde “Satıldı” etiketiyle görünür, sayfası açık, satın alma kapalı (varsayılan)
#  unlisted → listelerden çıkar, sayfası doğrudan bağlantıyla açık kalır
#  hidden   → sayfası da 404 olur (önerilmez)
SOLD_PRODUCTS_VISIBILITY=visible

# ---------------------------------------------------------------------
# Shopify Storefront API (STORE_MODE=shopify için)
# ---------------------------------------------------------------------
# Mağaza alan adı: magaza-adi.myshopify.com
SHOPIFY_STORE_DOMAIN=
# API sürümü (Shopify çeyreklik sürüm yayınlar; güncelleme öncesi sürüm notlarını kontrol edin)
SHOPIFY_API_VERSION=2026-10
# Headless kanalının PUBLIC Storefront erişim token'ı.
# Bu proje token'ı tarayıcıya göndermez; yine de “public” token gizli anahtar sayılmaz.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Headless kanalının PRIVATE Storefront token'ı — GİZLİDİR, yalnızca sunucuda. Tanımlıysa öncelikli kullanılır.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Webhook imza doğrulama anahtarı (Shopify yönetimi > Ayarlar > Bildirimler > Webhook'lar
# sayfasında gösterilen anahtar veya özel uygulamanın client secret'ı) — GİZLİDİR.
SHOPIFY_WEBHOOK_SECRET=
# Fiyat/stok bağlamı
SHOPIFY_COUNTRY=TR
SHOPIFY_LANGUAGE=TR

# Önbellek süreleri (saniye) — bkz. README “Güncelleme ve önbellek”
CATALOG_CACHE_TTL_SECONDS=300
PRODUCT_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------
# ASLA bu projeye eklemeyin:
#  - Shopify Admin API token'ları (shpat_…), uygulama client secret'ı (webhook dışında)
#  - PayTR merchant_key / merchant_salt (PayTR, Shopify yönetim panelinde bağlanır)
# ---------------------------------------------------------------------
