# =====================================================================
# İlkim Koleksiyon — ortam değişkenleri (ÖRNEK)
# Bu dosyayı `.env` adıyla kopyalayın. `.env` sürüm kontrolüne EKLENMEZ.
# Canlıda değerler hosting panelindeki ortam değişkenlerinden verilir.
# =====================================================================

# Sitenin tam adresi (canonical, Open Graph, sitemap, WhatsApp mesajındaki ürün bağlantısı). Sonunda / olmadan.
# Yerel: http://localhost:5500   Canlı: https://www.ornek-alan-adi.com.tr
SITE_URL=http://localhost:5500

# Veri kaynağı: local (src/data/catalog/*.json)
# İleride yönetim paneli ile birlikte "mysql" eklenecek (bkz. docs/YONETIM-PANELI.md).
DATA_SOURCE=local

# Arama motoru indekslemesi: off | on
# “on” olsa bile yalnızca SITE_URL gerçek bir https alan adıysa açılır.
SITE_INDEXING=off

# Satılmış ürünlerin görünürlüğü: visible | unlisted | hidden
#  visible  → listelerde “Satıldı” etiketiyle görünür, sayfası açık (varsayılan)
#  unlisted → listelerden çıkar, sayfası doğrudan bağlantıyla açık kalır
#  hidden   → sayfası da 404 olur (önerilmez)
SOLD_PRODUCTS_VISIBILITY=visible

# ---------------------------------------------------------------------
# İLERİDE (yönetim paneli + MySQL) — şimdilik kullanılmaz, doldurmayın.
# Gerçek değerler yalnızca hosting panelinde tutulur, depoya asla yazılmaz.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# UPLOADS_DIR=   (public_html ve derleme klasörü DIŞINDA kalıcı bir klasör)
# ---------------------------------------------------------------------
