---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductListing from '../../components/ProductListing.astro';
import { categories, categoryUrl } from '../../config/categories.js';
import { getAllProducts } from '../../lib/catalog.js';

const products = await getAllProducts();
---

<BaseLayout
  title="Mağaza"
  description="Tüm eski para ve koleksiyon ürünleri: ada göre arayın; ülke, dönem ve yıla göre filtreleyin."
  current="shop"
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Mağaza' }]} />
    <header class="page-head">
      <h1>Mağaza</h1>
      <p class="lead">Tüm ürünleri tek yerden inceleyin.</p>
      <nav aria-label="Kategoriler">
        <ul class="cat-links">
          {
            categories.map((c) => (
              <li>
                <a href={categoryUrl(c.slug)}>{c.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <ProductListing products={products} />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-2) var(--space-5);
  }

  .page-head .lead {
    margin-bottom: var(--space-4);
  }

  .cat-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 699px) {
    /* Mobilde kategori kısayolları tek satırda kayar; aynı seçenekler filtre panelinde de var. */
    .cat-links {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding: 2px var(--gutter) var(--space-2);
      scrollbar-width: thin;
    }

    .cat-links li {
      flex: none;
    }
  }

  .cat-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--heading);
    text-decoration: none;
    font-size: var(--fs-sm);
  }

  .cat-links a:hover {
    background: var(--surface-hover);
  }
</style>
