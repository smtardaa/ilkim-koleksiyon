---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductSlider from '../components/ProductSlider.astro';
import ProviderError from '../components/ProviderError.astro';
import Icon from '../components/Icon.astro';
import { loadCatalog, categoryUrl, collectionUrl, productUrl } from '../lib/catalog.js';
import { sectionRequests, buildHomeSections } from '../lib/home-sections.js';
import { bannerNotes, roundCoins, withImages } from '../lib/showcase.js';
import { organizationLd, websiteLd } from '../lib/seo.js';
import { topCategories } from '../config/navigation.js';
import { homeSliders } from '../config/home.js';
import { site, soldVisibility } from '../config/site.js';

let catalog: any = null;
let error: any = null;
let sliders: any[] = [];
try {
  catalog = await loadCatalog();
  const fetched = await catalog.provider.getHomeSections(sectionRequests(homeSliders));
  sliders = buildHomeSections({ config: homeSliders, fetched, urls: { categoryUrl, collectionUrl }, soldVisibility });
} catch (e) { error = e; Astro.response.status = 503; }

// Rehber bandındaki küçük görseller (yalnızca katalogda ürün varsa)
let band: any[] = [];
if (catalog?.products.length) {
  const P = catalog.products;
  const notes = bannerNotes(P, 40);
  band = [...new Map([
    roundCoins(P, 8).at(-1)?.p,
    notes[14] ?? notes.at(-1),
    withImages(P, (p: any) => p.specs.kind === 'set', 1)[0] ?? notes[1],
  ].filter(Boolean).map((p: any) => [p.id, p])).values()];
}
---
<BaseLayout
  title={`${site.name} — Kâğıt para, madeni para ve koleksiyon parçaları`}
  description="İlkim Koleksiyon kataloğu: T.C. ve yabancı madeni ve kâğıt paralar, hatıra paralar, nümismatik malzeme, gümüş takılar, vintage objeler, efemera, madalya, saat ve Osmanlı paraları."
  canonical="/"
  jsonLd={[organizationLd(), websiteLd()]}
>
  {error ? <ProviderError error={error} /> : (
  <>
  <section class="hero" aria-label="Katalogda ara">
    <div class="hero-inner">
      <h1 class="visually-hidden">{site.name} — nümismatik ve koleksiyon kataloğu</h1>
      <form class="search-field" action="/arama" method="get" role="search">
        <Icon name="search" />
        <label class="visually-hidden" for="hero-q">Katalogda ara</label>
        <input id="hero-q" type="search" name="q" placeholder="Ne keşfetmek istersin?" autocomplete="off" required />
        <button type="submit">Ara</button>
      </form>
      <a class="btn btn--lime hero-browse" href="#kategoriler">Koleksiyona göz at <Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="section" id="kategoriler" aria-labelledby="cat-title" tabindex="-1">
    <div class="container">
      <div class="section-head"><h2 id="cat-title">Koleksiyonunu seç</h2></div>
      <div class="cat-carousel" data-cat-carousel>
        <ul class="cat-grid" data-cat-track aria-label="Kategoriler">
          {topCategories.map((c: any) => (
            <li>
              <a class="cat-card" href={categoryUrl(c.path)}>
                {c.image?.src && <img class="cat-img" src={c.image.src} alt="" width="240" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
                <h3 class="cat-name">{c.title}</h3>
              </a>
            </li>
          ))}
        </ul>
        <div class="cat-carousel-nav">
          <button type="button" class="slider-btn" data-cat-prev aria-label="Önceki kategoriler"><Icon name="chevron-left" /></button>
          <button type="button" class="slider-btn" data-cat-next aria-label="Sonraki kategoriler"><Icon name="chevron-right" /></button>
        </div>
      </div>
      <ul class="cat-chips" aria-label="Kategori kısayolları">
        {topCategories.map((c: any) => <li><a href={categoryUrl(c.path)}>{c.title}</a></li>)}
      </ul>
    </div>
  </section>

  {sliders.map((section) => <ProductSlider section={section} />)}

  <section class="band on-dark" aria-labelledby="band-title">
    <div class="container band-inner">
      <div>
        <h2 id="band-title">Bir koleksiyon,<br />bin hikâye<span class="dot">.</span></h2>
        <a class="btn btn--copper-outline" href="/koleksiyon-rehberi">Koleksiyon rehberi <Icon name="arrow-up-right" /></a>
      </div>
      {band.length > 0 && (
        <div class="band-tiles">
          {band.map((p: any) => (
            <a class="band-tile" href={productUrl(p)} aria-label={p.title}>
              <img src={p.images[0].srcSmall} width={p.images[0].width} height={p.images[0].height} alt="" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  <script>
    import '../scripts/slider.js';
    import '../scripts/cat-carousel.js';
  </script>
  </>
  )}
</BaseLayout>
