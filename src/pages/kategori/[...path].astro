---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogView from '../../components/CatalogView.astro';
import ProviderError from '../../components/ProviderError.astro';
import { loadCatalog, search, categoryTrail, childCategories, categoryUrl } from '../../lib/catalog.js';
import { parseState, hasFilters } from '../../lib/search/engine.js';
import { breadcrumbLd, itemListLd } from '../../lib/seo.js';
import { site } from '../../config/site.js';
import { truncate } from '../../lib/format.js';

const path = (Astro.params.path ?? '').replace(/^\/+|\/+$/g, '');
const state = parseState(Astro.url.searchParams);
state.category = '';
let catalog: any = null, error: any = null, result: any = null, category: any = null;
try {
  catalog = await loadCatalog();
  category = catalog.catMap.get(path) ?? null;
  if (category) result = search(catalog, state, { pageSize: site.pageSize, baseCategory: path });
} catch (e) { error = e; Astro.response.status = 503; }

if (!error && !category) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

let crumbs: any[] = [], subs: any[] = [], title = '', description = '', canonical = '', filtered = false;
if (category) {
  const trail = categoryTrail(catalog, path);
  crumbs = [{ title: 'Ana sayfa', href: '/' }, { title: 'Kategoriler', href: '/kategori' }, ...trail];
  subs = childCategories(catalog, path).map((c: any) => ({ title: c.title, href: categoryUrl(c.path), count: c.productCount }));
  const parentTitles = trail.slice(0, -1).map((t: any) => t.title);
  title = [category.title, ...parentTitles.slice(-1)].join(' — ') + (state.page > 1 ? ` — Sayfa ${state.page}` : '');
  description = truncate(category.description
    ? `${category.description} ${category.productCount} ürün.`
    : `${[...parentTitles, category.title].join(' › ')}: ${category.productCount} ürün. Yıl, kondisyon, katalog numarası ve fiyata göre filtreleyin.`, 158);
  filtered = hasFilters(state) || !!state.q || state.sort !== 'onerilen';
  canonical = filtered ? categoryUrl(path) : state.page > 1 ? `${categoryUrl(path)}?sayfa=${state.page}` : categoryUrl(path);
}
---
<BaseLayout
  title={title || 'Kategori'}
  description={description}
  canonical={canonical || null}
  noindex={filtered || (category && category.productCount === 0)}
  jsonLd={category ? [breadcrumbLd(crumbs), itemListLd(result.items, category.title)] : undefined}
>
  {error ? <ProviderError error={error} /> : (
    <>
      <div class="container page-head">
        <Breadcrumbs items={crumbs} />
        <h1>{category.title}</h1>
        {category.description && <p class="lead muted">{category.description}</p>}
      </div>
      <div class="container">
        {category.productCount === 0 ? (
          <div class="empty-state" style="margin-bottom:64px">
            <h2>Bu kategoride şu anda ürün yok</h2>
            <p class="muted">“{category.title}” kategorisi mağaza yapısında yer alıyor; ürünler envantere eklendiğinde burada listelenecek.</p>
            <div class="actions">
              {category.parent && <a class="btn btn--outline" href={categoryUrl(category.parent)}>Üst kategoriye dön</a>}
              <a class="btn btn--lime" href="/urunler">Bütün ürünlere göz at</a>
            </div>
          </div>
        ) : (
          <CatalogView basePath={categoryUrl(path)} state={state} result={result} omitCategoryParam subcategories={subs} />
        )}
      </div>
    </>
  )}
</BaseLayout>
