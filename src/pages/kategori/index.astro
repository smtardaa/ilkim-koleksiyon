---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProviderError from '../../components/ProviderError.astro';
import CountryPicker from '../../components/CountryPicker.astro';
import { loadCatalog, categoryUrl } from '../../lib/catalog.js';
import { topCategories } from '../../config/navigation.js';
import { breadcrumbLd } from '../../lib/seo.js';

let catalog: any = null, error: any = null;
try { catalog = await loadCatalog(); } catch (e) { error = e; Astro.response.status = 503; }
const crumbs = [{ title: 'Ana sayfa', href: '/' }, { title: 'Kategoriler', href: '/kategori' }];
---
<BaseLayout title="Bütün kategoriler" description="İlkim Koleksiyon kategorileri: T.C. ve yabancı madeni ve kâğıt paralar, hatıra paralar, nümismatik malzeme, gümüş takılar, vintage objeler, efemera, madalya, saat ve Osmanlı paraları." canonical="/kategori" jsonLd={breadcrumbLd(crumbs)}>
  {error ? <ProviderError error={error} /> : (
    <div class="container" style="padding-bottom:64px">
      <div class="page-head">
        <Breadcrumbs items={crumbs} />
        <h1>Bütün kategoriler</h1>
      </div>
      <div class="cat-index">
        {topCategories.map((c) => (
          <section class="info-panel" aria-labelledby={`k-${c.path}`}>
            <h2 id={`k-${c.path}`}><a href={categoryUrl(c.path)}>{c.title}</a></h2>
            {c.description && <p class="small muted">{c.description}</p>}
            {c.countries && <CountryPicker category={c} countries={catalog.countries} />}
          </section>
        ))}
      </div>
    </div>
  )}
</BaseLayout>
