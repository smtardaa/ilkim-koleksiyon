---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CatalogView from '../components/CatalogView.astro';
import ProviderError from '../components/ProviderError.astro';
import Icon from '../components/Icon.astro';
import { loadCatalog, search } from '../lib/catalog.js';
import { parseState } from '../lib/search/engine.js';
import { site } from '../config/site.js';

const state = parseState(Astro.url.searchParams);
let catalog: any = null, error: any = null, result: any = null;
try {
  catalog = await loadCatalog();
  result = search(catalog, state, { pageSize: site.pageSize });
} catch (e) { error = e; Astro.response.status = 503; }
const crumbs = [{ title: 'Ana sayfa', href: '/' }, { title: 'Arama', href: '/arama' }];
const heading = state.q ? `“${state.q}” için sonuçlar` : 'Katalogda ara';
---
<BaseLayout title={state.q ? `${state.q} — Arama` : 'Arama'} description="İlkim Koleksiyon kataloğunda arama." canonical="/arama" noindex>
  {error ? <ProviderError error={error} /> : (
    <>
      <div class="container page-head">
        <Breadcrumbs items={crumbs} />
        <h1>{heading}</h1>
        <form action="/arama" method="get" role="search" style="max-width:640px;margin:10px 0 6px">
          <label class="search-field" style="color:var(--ink);background:var(--paper)">
            <Icon name="search" />
            <span class="visually-hidden">Arama ifadesi</span>
            <input type="search" name="q" value={state.q} placeholder="Ülke, yıl, nominal değer, emisyon, katalog no, metal…" autocomplete="off" />
            <button type="submit">Ara</button>
          </label>
        </form>
        <p class="small muted">Arama; ürün adı, ülke, yıl, nominal değer, emisyon, hükümdar, kondisyon, katalog numarası, sertifika ve metal alanlarında yapılır. Türkçe karakter ve büyük/küçük harf farkı gözetilmez (ör. “gumus” = “Gümüş”, “1.000” = “1000”).</p>
      </div>
      <div class="container">
        <CatalogView basePath="/arama" state={state} result={result}
          emptyTitle={state.q ? `“${state.q}” için sonuç bulunamadı` : 'Aramak istediğiniz ifadeyi yazın'}
          emptyText="Yazımı kontrol edin, daha genel bir ifade deneyin veya filtreleri kaldırın. Örnek: “almanya mark”, “5 emisyon”, “P-173a”." />
      </div>
    </>
  )}
</BaseLayout>
