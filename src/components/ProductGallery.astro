---
/**
 * Ürün galerisi: ön/arka yüz küçük resimleri, ana görsel ve tam ekran
 * inceleme (yakınlaştırma, kaydırma, klavye ile gezinme).
 * Görseller kesilmeden (object-fit: contain) gösterilir.
 */
import Icon from './Icon.astro';
import { imageAttrs } from '../lib/images.js';

const { images, title } = Astro.props;
const roleLabels = { obverse: 'Ön yüz', reverse: 'Arka yüz', overview: 'Genel görünüm', detail: 'Yakın görünüm' };
const items = images.map((img, i) => ({
  ...img,
  label: img.label ?? roleLabels[img.role] ?? `Görsel ${i + 1}`,
}));
const first = items[0];
const payload = JSON.stringify(items.map(({ url, alt, width, height, label }) => ({ url, alt, width, height, label })));
---

<div class="gallery" data-gallery data-images={payload}>
  <div class="gallery__stage">
    <button class="gallery__main" type="button" data-open-viewer>
      <img
        {...imageAttrs(first, { sizes: '(min-width: 1000px) 600px, 100vw' })}
        data-main
        fetchpriority="high"
        decoding="async"
      />
      <span class="visually-hidden" data-main-label>Tam ekran incele: {first.label}</span>
    </button>
    <span class="gallery__hint" aria-hidden="true">
      <Icon name="expand" size={16} /> Tam ekran incele
    </span>
  </div>

  {
    items.length > 1 && (
      <ul class="gallery__thumbs" aria-label={`${title} görselleri`}>
        {items.map((img, i) => (
          <li>
            <button type="button" data-thumb={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <img src={img.url} alt="" width={img.width} height={img.height} loading="lazy" decoding="async" />
              <span>{img.label}</span>
            </button>
          </li>
        ))}
      </ul>
    )
  }

  <dialog class="viewer" data-viewer aria-label={`${title} — görsel inceleme`}>
    <div class="viewer__bar">
      <p class="viewer__counter" data-counter aria-live="polite"></p>
      <div class="viewer__actions">
        <button class="icon-btn" type="button" data-zoom aria-pressed="false">
          <span class="visually-hidden" data-zoom-label>Yakınlaştır</span>
          <Icon name="zoom-in" class="zoom-in" />
          <Icon name="zoom-out" class="zoom-out" />
        </button>
        <button class="icon-btn" type="button" data-close>
          <span class="visually-hidden">Kapat</span>
          <Icon name="close" />
        </button>
      </div>
    </div>
    <div class="viewer__canvas" data-canvas tabindex="0" aria-label="Görsel alanı. Yakınlaştırınca ok tuşlarıyla kaydırabilirsiniz.">
      <img data-viewer-img alt="" />
    </div>
    {
      items.length > 1 && (
        <>
          <button class="icon-btn viewer__nav viewer__nav--prev" type="button" data-prev>
            <span class="visually-hidden">Önceki görsel</span>
            <Icon name="chevron-left" size={28} />
          </button>
          <button class="icon-btn viewer__nav viewer__nav--next" type="button" data-next>
            <span class="visually-hidden">Sonraki görsel</span>
            <Icon name="chevron-right" size={28} />
          </button>
        </>
      )
    }
  </dialog>
</div>

<script>
  import { initGallery } from '../scripts/gallery.js';
  document.querySelectorAll('[data-gallery]').forEach(initGallery);
</script>

<style>
  .gallery {
    display: grid;
    gap: var(--space-3);
  }

  .gallery__stage {
    position: relative;
  }

  .gallery__main {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--photo-bg);
    cursor: zoom-in;
  }

  .gallery__main img {
    position: absolute;
    top: 6%;
    left: 6%;
    width: 88%;
    height: 88%;
    object-fit: contain;
  }

  .gallery__hint {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: rgb(22 13 9 / 0.85);
    color: var(--heading);
    font-size: var(--fs-xs);
    pointer-events: none;
  }

  .gallery__thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: var(--space-2);
  }

  .gallery__thumbs button {
    width: 100%;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer;
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .gallery__thumbs img {
    aspect-ratio: 4 / 3;
    width: 100%;
    height: auto;
    padding: 6%;
    object-fit: contain;
    background: var(--photo-bg);
    border-radius: var(--radius-sm);
  }

  .gallery__thumbs button[aria-pressed='true'] {
    border-color: var(--c-caramel);
    box-shadow: inset 0 0 0 1px var(--c-caramel);
    color: var(--heading);
    font-weight: 600;
  }

  /* Tam ekran görüntüleyici */
  .viewer {
    max-width: 100vw;
    max-height: 100dvh;
    width: 100vw;
    height: 100dvh;
    border-radius: 0;
    background: var(--c-ink);
    color: var(--text);
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .viewer::backdrop {
    background: var(--c-ink);
  }

  .viewer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-5);
  }

  .viewer__counter {
    margin: 0;
    font-size: var(--fs-sm);
  }

  .viewer__actions {
    display: flex;
    gap: var(--space-1);
  }

  .viewer .icon-btn {
    color: var(--text);
  }

  .viewer .icon-btn:hover {
    background: var(--surface-hover);
    color: var(--c-white);
  }

  .viewer :focus-visible {
    outline-color: var(--c-caramel);
  }

  .viewer :global(.zoom-out),
  .viewer [aria-pressed='true'] :global(.zoom-in) {
    display: none;
  }

  .viewer [aria-pressed='true'] :global(.zoom-out) {
    display: block;
  }

  .viewer__canvas {
    position: relative;
    overflow: auto;
    display: grid;
    place-items: center;
    padding: var(--space-4) var(--space-7);
    cursor: zoom-in;
    overscroll-behavior: contain;
  }

  .viewer__canvas img {
    max-width: 100%;
    max-height: calc(100dvh - 120px);
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    background: var(--surface);
    border-radius: var(--radius);
  }

  .viewer__canvas.is-zoomed {
    display: block;
    cursor: grab;
    padding: 0;
  }

  .viewer__canvas.is-zoomed.is-dragging {
    cursor: grabbing;
  }

  .viewer__canvas.is-zoomed img {
    max-width: none;
    max-height: none;
    width: var(--zoom-w);
    margin: auto;
  }

  .viewer__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgb(22 13 9 / 0.75) !important;
  }

  .viewer__nav--prev {
    left: var(--space-2);
  }

  .viewer__nav--next {
    right: var(--space-2);
  }

  @media (max-width: 600px) {
    .viewer__canvas {
      padding-inline: var(--space-3);
    }

    .viewer__nav {
      top: auto;
      bottom: var(--space-4);
      transform: none;
    }
  }
</style>
