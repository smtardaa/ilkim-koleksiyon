---
/**
 * Gezinme yolu. Son öğe bulunulan sayfadır ve bağlantı değildir.
 * SITE_URL tanımlıysa BreadcrumbList yapılandırılmış verisi de eklenir.
 * @prop items [{ label, href? }]
 */
const { items } = Astro.props;
const site = Astro.site;

const jsonLd = site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: items.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.label,
        ...(item.href ? { item: new URL(item.href, site).href } : {}),
      })),
    }
  : null;
---

<nav class="breadcrumbs" aria-label="Bulunduğunuz yer">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {item.href && i < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<style>
  .breadcrumbs {
    font-size: var(--fs-sm);
    padding-block: var(--space-4) var(--space-2);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  li + li::before {
    content: '/';
    color: var(--c-gray-line);
  }

  a {
    color: var(--muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  [aria-current='page'] {
    color: var(--heading);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
