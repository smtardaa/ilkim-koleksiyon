---
/**
 * Ürün detayı. Tek parça ürünler (/urun/...) ve koleksiyon paketleri
 * (/koleksiyonlar/...) aynı düzeni kullanır; paketlerde içerik listesi eklenir.
 */
import ProductGallery from './ProductGallery.astro';
import ProductCard from './ProductCard.astro';
import OfferDialog from './OfferDialog.astro';
import Icon from './Icon.astro';
import { getCondition, conditionScale } from '../config/conditions.js';
import { store, whatsappLink } from '../config/store.js';
import { productUrl } from '../lib/catalog.js';
import { formatPrice, formatDate, conditionText, stockText, yearText } from '../lib/format.js';

const { product, related = [] } = Astro.props;
const p = product;
const sold = !p.availableForSale;
const condition = getCondition(p.condition);
const price = formatPrice(p.price.amount, p.price.currencyCode);
const isSet = p.kind === 'set';
const pageUrl = Astro.site ? new URL(productUrl(p), Astro.site).href : productUrl(p);
const wa = whatsappLink(`Merhaba, “${p.title}” (${pageUrl}) hakkında bilgi almak istiyorum.`);

const cartItem = JSON.stringify({
  id: p.id,
  handle: p.handle,
  title: p.title,
  url: productUrl(p),
  price: p.price.amount,
  currencyCode: p.price.currencyCode,
  image: p.images[0]?.url ?? '',
  imageAlt: p.images[0]?.alt ?? '',
  maxQuantity: p.quantityAvailable,
});

const facts = [
  ['Ülke', p.country],
  ['Dönem', p.period],
  p.series && ['Seri', p.series],
  ['Yıl', yearText(p)],
  ['Kondisyon', p.certificate ? `${p.certificate.issuer} ${p.certificate.grade}` : conditionText(p.condition)],
  p.catalogNumbers.length && ['Katalog no.', p.catalogNumbers.map((c) => `${c.system} ${c.value}`).join(', ')],
  isSet && ['Parça sayısı', `${p.pieceCount} parça`],
].filter(Boolean);

const specs = [
  p.denomination && ['Kupür / değer', p.denomination],
  ['Malzeme', p.material ?? 'Kaynakta belirtilmemiş'],
  ['Ölçüler', p.dimensions ?? 'Kaynakta belirtilmemiş'],
  p.weight && ['Ağırlık', p.weight],
  ['Eklenme tarihi (demo)', formatDate(p.createdAt)],
].filter(Boolean);

// Aynı kaynağa ait birden fazla görseli tek satırda göster.
const credits = [...new Map(p.images.filter((i) => i.credit).map((i) => [i.credit.sourceUrl + i.credit.author, i])).values()];
---

<article class="pd" data-product-page data-cart-item={cartItem}>
  <div class="pd__top">
    <div class="pd__gallery">
      <ProductGallery images={p.images} title={p.title} />
    </div>

    <div class="pd__buy">
      {isSet && <span class="eyebrow">Koleksiyon paketi · {p.pieceCount} parça</span>}
      <h1>{p.title}</h1>
      <p class="pd__price">
        {price} {p.price.isExample && <span class="example-tag">örnek fiyat</span>}
      </p>
      {isSet && <p class="pd__included">Fiyata paketteki {p.pieceCount} parçanın tamamı dahildir.</p>}

      <dl class="facts">
        {
          facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>

      <p class:list={['stock', sold ? 'stock--sold' : 'stock--in']}>{stockText(p)}</p>

      <div class="pd__actions">
        {
          sold ? (
            <button class="btn btn--primary btn--block" type="button" disabled>
              Bu ürün satıldı
            </button>
          ) : (
            <button class="btn btn--primary btn--block" type="button" data-add-to-cart>
              <Icon name="cart" size={20} /> Sepete ekle
            </button>
          )
        }
        <p class="pd__added" data-add-status role="status"></p>

        <div class="pd__secondary">
          {
            p.offerEnabled && !sold && (
              <button class="btn btn--secondary" type="button" data-offer-open>
                <Icon name="tag" size={18} /> Teklif ver
              </button>
            )
          }
          {
            wa ? (
              <a class="btn btn--secondary" href={wa} target="_blank" rel="noopener">
                <Icon name="whatsapp" size={18} /> WhatsApp’tan sor
              </a>
            ) : (
              <button class="btn btn--secondary" type="button" disabled aria-describedby="wa-missing">
                <Icon name="whatsapp" size={18} /> WhatsApp’tan sor
              </button>
            )
          }
        </div>
        {
          !wa && (
            <p class="hint" id="wa-missing">
              WhatsApp numarası henüz eklenmedi; bağlantı numara girildiğinde etkinleşir.
            </p>
          )
        }
      </div>

      {
        p.isSample && (
          <p class="notice notice--demo pd__sample">
            <Icon name="info" size={18} />
            <span>
              <strong>Demo ürünü.</strong> Bilgiler ve fotoğraf, aşağıda kaynağı verilen gerçek bir koleksiyon kaydından
              alındı; bu parça İlkim Koleksiyon’un stoğunda değildir. Fiyat ve stok durumu örnektir.
            </span>
          </p>
        )
      }
    </div>
  </div>

  <div class="pd__details">
    <section aria-labelledby="aciklama">
      <h2 id="aciklama">Açıklama</h2>
      {p.description.map((para) => <p>{para}</p>)}
    </section>

    {
      isSet && p.setItems?.length && (
        <section aria-labelledby="icerik-listesi">
          <h2 id="icerik-listesi">Paket içeriği ({p.pieceCount} parça)</h2>
          <p class="pd__muted">Aşağıdaki parçaların tamamı paket fiyatına dahildir.</p>
          <div class="table-wrap" tabindex="0" role="region" aria-labelledby="icerik-listesi">
            <table class="set-table">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Parça</th>
                  <th scope="col">Yıl</th>
                  <th scope="col">Dönem</th>
                  <th scope="col">Kondisyon</th>
                  <th scope="col">Not</th>
                </tr>
              </thead>
              <tbody>
                {p.setItems.map((item, i) => (
                  <tr>
                    <td>{i + 1}</td>
                    <th scope="row">{item.title}</th>
                    <td>{item.year ?? 'Okunamıyor'}</td>
                    <td>{item.period ?? '—'}</td>
                    <td>{item.condition ? conditionText(item.condition) : '—'}</td>
                    <td>{item.note ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section aria-labelledby="kondisyon">
      <h2 id="kondisyon">Kondisyon</h2>
      {
        condition ? (
          <p>
            <strong>{conditionText(p.condition)}</strong> — {condition.summary}{' '}
            <span class="pd__muted">(Yaklaşık uluslararası karşılığı: {condition.intl})</span>
          </p>
        ) : (
          <p>
            {p.certificate
              ? `Kondisyon için ${p.certificate.issuer} derecesi esas alınır: ${p.certificate.grade}.`
              : 'Kaynak kayıtta kondisyon derecesi verilmemiş; tahmini bir derece yazılmadı.'}
          </p>
        )
      }
      {p.conditionNote && <p>{p.conditionNote}</p>}
      {
        p.defects.length > 0 ? (
          <>
            <h3>Kondisyonu etkileyen kusurlar</h3>
            <ul class="defects">
              {p.defects.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </>
        ) : (
          <p class="pd__muted">Kaynakta kondisyonu etkileyen bir kusur belirtilmemiş.</p>
        )
      }
      <details class="disclosure">
        <summary>Kondisyon ölçeği</summary>
        <dl class="scale">
          {
            conditionScale.map((c) => (
              <div>
                <dt>
                  {c.label} ({c.short}) <span class="pd__muted">· {c.intl}</span>
                </dt>
                <dd>{c.summary}</dd>
              </div>
            ))
          }
        </dl>
      </details>
    </section>

    {
      p.certificate && (
        <section aria-labelledby="sertifika">
          <h2 id="sertifika">Sertifika</h2>
          <dl class="facts facts--plain">
            <div>
              <dt>Kuruluş</dt>
              <dd>{p.certificate.issuer}</dd>
            </div>
            <div>
              <dt>Derece</dt>
              <dd>
                {p.certificate.grade}
                {p.certificate.gradeLabel && ` · ${p.certificate.gradeLabel}`}
              </dd>
            </div>
            <div>
              <dt>Sertifika no.</dt>
              <dd>{p.certificate.number}</dd>
            </div>
          </dl>
          {p.certificate.verifyUrl ? (
            <p>
              <a href={p.certificate.verifyUrl} target="_blank" rel="noopener">
                Sertifikayı kuruluşun sitesinde doğrula
              </a>
            </p>
          ) : (
            <p class="pd__muted">Bu ürün için doğrulama bağlantısı eklenmedi.</p>
          )}
        </section>
      )
    }

    <section aria-labelledby="teknik">
      <h2 id="teknik">Teknik bilgiler</h2>
      <dl class="facts facts--plain">
        {
          specs.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      (p.source || credits.length > 0) && (
        <section aria-labelledby="kaynak">
          <h2 id="kaynak">Kaynak ve görsel lisansı</h2>
          {p.source && (
            <p>
              Ürün bilgileri:{' '}
              <a href={p.source.url} target="_blank" rel="noopener">
                {p.source.label}
              </a>{' '}
              <span class="pd__muted">(kontrol: {formatDate(p.source.checkedAt)})</span>
            </p>
          )}
          {p.imageNote && <p class="pd__muted">{p.imageNote}</p>}
          <ul class="credits">
            {credits.map((i) => (
              <li>
                Görsel: {i.credit.author} ·{' '}
                {i.credit.license.url ? (
                  <a href={i.credit.license.url} target="_blank" rel="noopener license">
                    {i.credit.license.name}
                  </a>
                ) : (
                  i.credit.license.name
                )}{' '}
                ·{' '}
                <a href={i.credit.sourceUrl} target="_blank" rel="noopener">
                  {i.credit.sourceLabel}
                </a>
                {i.credit.note && <span class="pd__muted"> — {i.credit.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="teslimat">
      <h2 id="teslimat">Kargo, iade ve orijinallik</h2>
      <details class="disclosure">
        <summary>Kargo ve teslimat</summary>
        {store.policies.shipping ? <p>{store.policies.shipping}</p> : <p class="placeholder-value">İşletme tarafından eklenecek.</p>}
      </details>
      <details class="disclosure">
        <summary>İade koşulları</summary>
        {store.policies.returns ? <p>{store.policies.returns}</p> : <p class="placeholder-value">İşletme tarafından eklenecek.</p>}
      </details>
      <details class="disclosure">
        <summary>Orijinallik kontrolü</summary>
        {
          store.policies.authenticity ? (
            <p>{store.policies.authenticity}</p>
          ) : (
            <p class="placeholder-value">İşletme tarafından eklenecek.</p>
          )
        }
      </details>
    </section>
  </div>

  {
    related.length > 0 && (
      <section class="pd__related" aria-labelledby="benzer">
        <h2 id="benzer">Benzer ürünler</h2>
        <ul class="product-grid product-grid--4">
          {related.map((r) => (
            <ProductCard product={r} />
          ))}
        </ul>
      </section>
    )
  }

  {p.offerEnabled && !sold && <OfferDialog product={p} />}
</article>

<script>
  import { initProductPage } from '../scripts/product-page.js';
  document.querySelectorAll('[data-product-page]').forEach(initProductPage);
</script>

<style>
  .pd__top {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-2);
  }

  @media (min-width: 960px) {
    .pd__top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }

    .pd__buy {
      position: sticky;
      top: calc(var(--header-h) + var(--space-4));
    }
  }

  .pd__buy h1 {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-2);
  }

  .pd__price {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--heading);
    margin-bottom: var(--space-2);
    font-variant-numeric: tabular-nums;
  }

  .pd__included {
    font-size: var(--fs-sm);
    color: var(--heading);
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
  }

  .facts {
    margin: var(--space-4) 0;
    display: grid;
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  .facts dt {
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    color: var(--heading);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .facts--plain {
    max-width: 560px;
  }

  .pd__actions {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .pd__actions > .btn {
    min-height: 52px;
    font-size: var(--fs-md);
  }

  .pd__added {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--stock-in);
    font-weight: 600;
    min-height: 1.2em;
  }

  .pd__added :global(a) {
    margin-left: var(--space-2);
  }

  .pd__secondary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pd__secondary .btn {
    flex: 1 1 180px;
  }

  .pd__actions .hint {
    margin: 0;
  }

  .pd__sample {
    margin-top: var(--space-5);
  }

  .pd__details {
    display: grid;
    gap: var(--space-6);
    max-width: 820px;
    margin-top: var(--space-7);
  }

  .pd__details h2 {
    font-size: var(--fs-lg);
  }

  .pd__details h3 {
    font-size: var(--fs-base);
    margin-top: var(--space-4);
  }

  .pd__muted {
    color: var(--muted);
  }

  .defects {
    margin: 0 0 var(--space-4);
    padding-left: 1.25rem;
  }

  .defects li + li {
    margin-top: var(--space-1);
  }

  .disclosure {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    margin-top: var(--space-2);
  }

  .disclosure summary {
    cursor: pointer;
    min-height: var(--tap);
    display: flex;
    align-items: center;
    padding: 0 var(--space-4);
    font-weight: 600;
    color: var(--heading);
  }

  .disclosure > :not(summary) {
    margin: 0;
    padding: 0 var(--space-4) var(--space-4);
  }

  .scale {
    display: grid;
    gap: var(--space-2);
    font-size: var(--fs-sm);
  }

  .scale dt {
    font-weight: 600;
  }

  .scale dd {
    margin: 0;
    color: var(--muted);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .set-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    min-width: 560px;
  }

  .set-table th,
  .set-table td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .set-table thead th {
    background: var(--surface);
    color: var(--heading);
    font-weight: 650;
  }

  .set-table tbody th {
    font-weight: 600;
    color: var(--heading);
  }

  .set-table tr:last-child > * {
    border-bottom: 0;
  }

  .credits {
    margin: 0;
    padding-left: 1.25rem;
    font-size: var(--fs-sm);
    display: grid;
    gap: var(--space-2);
  }

  .pd__price .example-tag {
    vertical-align: middle;
    margin-left: var(--space-2);
  }

  .pd__related {
    margin-top: var(--space-8);
  }
</style>
