---
/**
 * Marka yazısı. Logo hazır olana kadar metin olarak gösterilir.
 * Referans font Decondol'dür (Alit Design, ticari kullanım lisans gerektirir);
 * lisans alınana kadar OFL lisanslı Federo geçici olarak kullanılır.
 */
import { store } from '../config/store.js';
import { url } from '../lib/paths.js';

const { as = 'a', href = url('/'), size = 'md', class: className } = Astro.props;
const Tag = as;
---

<Tag class:list={['brand', `brand--${size}`, className]} href={Tag === 'a' ? href : undefined}>
  <span class="brand__text">{store.wordmark}</span>
  {Tag === 'a' && <span class="visually-hidden"> — ana sayfa</span>}
</Tag>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-brand);
    font-weight: 400;
    color: var(--heading);
    text-decoration: none;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--accent);
  }

  .brand--md {
    font-size: 1.375rem;
  }

  .brand--lg {
    font-size: 1.875rem;
  }

  @media (min-width: 768px) {
    .brand--md {
      font-size: 1.625rem;
    }
  }
</style>
