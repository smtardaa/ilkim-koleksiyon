---
import Icon from './Icon.astro';
import { formatMoney, KIND_LABEL } from '../lib/format.js';
import { productUrl } from '../lib/catalog.js';
import { whatsappProductUrl } from '../config/business.js';
import { publicOrigin } from '../config/site.js';

interface Props {
  product: any;
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
  categoryLabel?: string | null;
}
const { product: p, eager = false, headingLevel = 'h3', categoryLabel = null } = Astro.props;
const Heading = headingLevel;
const img = p.images[0];
const status = p.availability.status;
const metaParts = [
  categoryLabel ?? (p.specs.kind ? KIND_LABEL[p.specs.kind] : null),
  p.specs.country,
  p.specs.yearText && p.specs.calendar === 'hicri' ? `H. ${p.specs.yearText}` : p.specs.yearText,
].filter(Boolean);
const cert = p.specs.certification;
// Satılmış/stokta olmayan ürün için iletişim düğmesi gösterilmez.
const contactUrl = status === 'in_stock' ? whatsappProductUrl(p, publicOrigin(Astro.url) + productUrl(p)) : null;
---
<article class:list={['p-card', { 'is-sold': status === 'sold' }]}>
  <a class="media" href={productUrl(p)} tabindex="-1" aria-hidden="true">
    {img ? (
      <img
        src={img.srcSmall ?? img.src}
        alt=""
        width={img.width > 600 ? 600 : img.width}
        height={img.width > 600 ? Math.round(600 * img.height / img.width) : img.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <span class="muted small" style="display:grid;place-items:center;height:100%">Görsel yok</span>
    )}
  </a>
  {status === 'sold' && <span class="status-badge status-badge--sold">Satıldı</span>}
  {status === 'out_of_stock' && <span class="status-badge status-badge--oos">Stokta yok</span>}
  {cert && <span class="status-badge status-badge--cert" title="Sertifika">{cert.service}{cert.grade ? ` ${cert.grade}` : ''}</span>}
  <div class="body">
    <Heading class="title"><a href={productUrl(p)}>{p.title}</a></Heading>
    {metaParts.length > 0 && <p class="meta">{metaParts.join(' · ')}</p>}
    <div class="foot">
      <span class="price">
        {p.compareAtPrice && p.compareAtPrice.amount > p.price.amount && <s>{formatMoney(p.compareAtPrice)}</s>}
        <span class="visually-hidden">Fiyat: </span>{formatMoney(p.price)}
      </span>
      {contactUrl && (
        <a class="add contact-btn" href={contactUrl} target="_blank" rel="noopener" aria-label={`Satın almak için iletişime geç: ${p.title}`}>
          <Icon name="whatsapp" />
        </a>
      )}
    </div>
  </div>
</article>
