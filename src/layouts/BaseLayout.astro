---
import '@fontsource/federo/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { store } from '../config/store.js';

/**
 * Ortak sayfa düzeni ve SEO etiketleri.
 * - title / description sayfaya özeldir.
 * - canonical ve og:url yalnızca SITE_URL tanımlıysa üretilir.
 * - PUBLIC_ALLOW_INDEXING=true değilse tüm sayfalar noindex olur.
 */
const {
  title,
  description,
  image = null,
  type = 'website',
  noindex = false,
  jsonLd = [],
  current = null,
} = Astro.props;

const fullTitle = title ? `${title} | ${store.name}` : `${store.name} — Eski Para ve Koleksiyon Ürünleri`;
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && !noindex;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : null;
const ogImage = site && image ? new URL(image, site).href : null;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#160d09" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <meta property="og:site_name" content={store.name} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    <Header current={current} />
    <main id="icerik" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
