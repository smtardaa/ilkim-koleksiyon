{
  "name": "ilkim-koleksiyon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "İlkim Koleksiyon — Astro tabanlı nümismatik ve koleksiyon kataloğu (satın alma WhatsApp ile iletişim üzerinden)",
  "scripts": {
    "dev": "astro dev --port 5500 --host 127.0.0.1",
